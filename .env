# PostgreSQL Database Configuration
# NOTE: Set to 5434 locally because host has a pre-installed Windows PostgreSQL service on 5432
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=streamcost
POSTGRES_USER=streamcost
POSTGRES_PASSWORD=streamcost

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=cloud-cost-events

# Event Generator Configuration
EVENT_INTERVAL_SECONDS=1
ANOMALY_PROBABILITY=0.03
MAX_EVENTS=0
